// sequelize-cli paths. Migrations/seeders are CommonJS (their folders contain
// a package.json with "type": "commonjs"), so generated .js files load correctly.
const path = require('node:path');

module.exports = {
  config: path.resolve('src', 'config', 'database.cjs'),
  'migrations-path': path.resolve('src', 'migrations'),
  'seeders-path': path.resolve('src', 'seeders'),
  'models-path': path.resolve('src', 'modules'),
};
