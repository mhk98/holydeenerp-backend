# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Holydeen ERP

# ── Database (MySQL 8) ──────────────────────────────
# Matches the defaults in docker-compose.yml (this folder).
DB_HOST=82.197.82.157
DB_PORT=3306
DB_NAME=u172109161_holydeen_erp
DB_USER=u172109161_holydeen_erp
DB_PASSWORD="KHAtarnak@@98"
DB_TIMEZONE=+06:00
DB_POOL_MAX=10
DB_LOGGING=false

# ── Auth ────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=9a95ca6bd8b1e5cfbdb95c0aa9513c1c8ae49efc9f4b8744f23b5af32ed286a0980eed363a9fe5a5d6189b5dc0c089b1
JWT_REFRESH_SECRET=bf88fcf517acb1dc5389ef768e639c0633346fe2c06ecdee6c693c8ae6809e7d6a20269c47278339821005f47c473f4b
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Security ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
# ── Testing ─────────────────────────────────────────
# A SEPARATE, empty database — the test suite drops and recreates its tables.
DB_NAME_TEST=
# Run tests against DB_NAME itself (wipes and re-seeds it). Development databases only.
TEST_ALLOW_MAIN_DB=true

# ── Web app / cookies ───────────────────────────────
APP_URL=http://localhost:5173
# Defaults to true in production. Use COOKIE_SAMESITE=none (+ secure) if the API and web app are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=69c42ba6f54fbeb04ed2e5ab2f20166ea57227a87c8972bb40625ed344cfbd8c

# ── Auth policy ─────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Email (SMTP) ────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Holydeen ERP
MAIL_FROM_EMAIL=no-reply@holydeen.com

# ── Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
# Cloudinary for images (avatars, logos, product photos). Leave empty to store them in UPLOAD_DIR.
# Required on hosts with an ephemeral disk (e.g. Render). Accounting attachments always stay on disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=holydeen

# ── Backups ─────────────────────────────────────────
# Absolute path recommended in production (outside the deployed app folder).
BACKUP_DIR=backups
